---
import Layout from '../layouts/Layout.astro';
---

<Layout title="3CLEANING SERVICE | Junk Removal & Pressure Washing Tri-Cities WA" description="Professional cleaning services.">
<!-- Hero -->
    <section class="hero">
        <div class="container">
            <div class="hero-grid">
                <div>
                    <div class="hero-rating">
                        <span class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i
                                class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></span>
                        <span>4.9/5 from 127+ happy customers</span>
                    </div>
                    <h1>Professional Cleaning & Removal in <span class="highlight">Tri-Cities</span></h1>
                    <p>Junk removal, pressure washing, and trash bin services for homes and businesses across Pasco,
                        Richland, Kennewick & Walla Walla. Licensed, insured, and on-time.</p>
                    <div class="hero-actions">
                        <a href="/contact" class="btn btn-primary btn-lg"><i class="fas fa-calendar-check"></i> Free
                            Quote</a>
                        <a href="tel:+15095280560" class="btn btn-outline btn-lg"
                            style="color:white;border-color:rgba(255,255,255,0.3);"><i class="fas fa-phone"></i> (509)
                            528-0560</a>
                    </div>
                    <div class="hero-trust">
                        <div class="hero-trust-item"><i class="fas fa-shield-alt"></i> Licensed & Insured</div>
                        <div class="hero-trust-item"><i class="fas fa-clock"></i> Same-Day Service</div>
                        <div class="hero-trust-item"><i class="fas fa-tag"></i> Upfront Pricing</div>
                    </div>
                </div>
                <div class="hero-visual">
                    <img src="assets/images/five.jpeg" alt="Professional cleaning service Tri-Cities WA">
                    <div class="hero-review-float">
                        <div class="avatar">JD</div>
                        <div class="content">
                            <div class="name">Just finished!</div>
                            <div class="text">"Amazing work, highly recommend!"</div>
                            <div class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i
                                    class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Services -->
    <section class="section" id="services">
        <div class="container">
            <div class="section-header">
                <span class="section-label">Our Services</span>
                <h2>What We Do Best</h2>
                <p>Transparent pricing, professional equipment, and guaranteed satisfaction on every job.</p>
            </div>
            <div class="services-grid">
                <div class="service-card">
                    <div class="card-icon"><i class="fas fa-truck-loading"></i></div>
                    <h3>Junk Removal</h3>
                    <p>Full-service removal for furniture, appliances, yard waste, and construction debris. We handle
                        the heavy lifting.</p>
                    <ul class="features">
                        <li><i class="fas fa-check"></i> Furniture & Appliances</li>
                        <li><i class="fas fa-check"></i> Construction Debris</li>
                        <li><i class="fas fa-check"></i> Garage Cleanouts</li>
                    </ul>
                    <div class="price">$325 <span>per load</span></div>
                    <a href="contact.html?service=junk" class="btn btn-primary">Book Now</a>
                </div>
                <div class="service-card">
                    <div class="card-icon"><i class="fas fa-spray-can"></i></div>
                    <h3>Pressure Washing</h3>
                    <p>Restore driveways, siding, decks, and patios with commercial-grade pressure washing equipment.
                    </p>
                    <ul class="features">
                        <li><i class="fas fa-check"></i> Driveway & Sidewalk</li>
                        <li><i class="fas fa-check"></i> House Siding</li>
                        <li><i class="fas fa-check"></i> Deck & Patio</li>
                    </ul>
                    <div class="price">$175 <span>starting</span></div>
                    <a href="contact.html?service=pressure" class="btn btn-primary">Book Now</a>
                </div>
                <div class="service-card">
                    <div class="card-icon"><i class="fas fa-trash-alt"></i></div>
                    <h3>Trash Bin Service</h3>
                    <p>Convenient bin rental and pickup for events, renovations, and ongoing waste management.</p>
                    <ul class="features">
                        <li><i class="fas fa-check"></i> Event Waste Management</li>
                        <li><i class="fas fa-check"></i> Construction Bins</li>
                        <li><i class="fas fa-check"></i> Scheduled Pickup</li>
                    </ul>
                    <div class="price">$20 <span>per bin</span></div>
                    <a href="contact.html?service=bin" class="btn btn-primary">Book Now</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Process -->
    <section class="section bg-light">
        <div class="container">
            <div class="section-header">
                <span class="section-label">How It Works</span>
                <h2>Simple 3-Step Process</h2>
                <p>From quote to clean-up, we make it effortless.</p>
            </div>
            <div class="process-grid">
                <div class="process-step">
                    <div class="number">1</div>
                    <h3>Request Quote</h3>
                    <p>Call, WhatsApp, or fill our form. Get a free, no-obligation quote in minutes.</p>
                </div>
                <div class="process-step">
                    <div class="number">2</div>
                    <h3>We Handle Everything</h3>
                    <p>Our team arrives on time with all equipment. We lift, clean, and haul away.</p>
                </div>
                <div class="process-step">
                    <div class="number">3</div>
                    <h3>Enjoy Clean Space</h3>
                    <p>Pay only when satisfied. We dispose responsibly and leave no mess behind.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Testimonials -->
    <section class="section">
        <div class="container">
            <div class="section-header">
                <span class="section-label">Testimonials</span>
                <h2>What Customers Say</h2>
                <p>Real reviews from homeowners across the Tri-Cities area.</p>
            </div>
            <div class="swiper testimonial-swiper" style="padding-bottom: 3rem;">
                <div class="swiper-wrapper">
                    <div class="swiper-slide">
                        <div class="testimonial-card">
                            <div class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i
                                    class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div>
                            <p class="quote">"3CLEANING cleared my entire garage in under 2 hours. Professional, fast, and
                                exactly what they quoted. Best junk removal in Pasco!"</p>
                            <div class="author">
                                <div class="avatar">SM</div>
                                <div class="info">
                                    <div class="name">Sarah M.</div>
                                    <div class="meta">Pasco, WA · Garage Cleanout</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="swiper-slide">
                        <div class="testimonial-card">
                            <div class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i
                                    class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div>
                            <p class="quote">"Had them pressure wash my driveway and house siding. The difference is night and
                                day! My neighbor already asked for their number."</p>
                            <div class="author">
                                <div class="avatar">MT</div>
                                <div class="info">
                                    <div class="name">Mike T.</div>
                                    <div class="meta">Richland, WA · Pressure Washing</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="swiper-slide">
                        <div class="testimonial-card">
                            <div class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i
                                    class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div>
                            <p class="quote">"Rented trash bins for our construction project in Kennewick. Delivery was prompt,
                                pickup on schedule, and pricing was fair. Will use again!"</p>
                            <div class="author">
                                <div class="avatar">JL</div>
                                <div class="info">
                                    <div class="name">James L.</div>
                                    <div class="meta">Kennewick, WA · Trash Bin Rental</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Duplications mapping so Swiper loop behaves flawlessly -->
                    <div class="swiper-slide">
                        <div class="testimonial-card">
                            <div class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i
                                    class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div>
                            <p class="quote">"3CLEANING cleared my entire garage in under 2 hours. Professional, fast, and
                                exactly what they quoted. Best junk removal in Pasco!"</p>
                            <div class="author">
                                <div class="avatar">SM</div>
                                <div class="info">
                                    <div class="name">Sarah M.</div>
                                    <div class="meta">Pasco, WA · Garage Cleanout</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="swiper-slide">
                        <div class="testimonial-card">
                            <div class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i
                                    class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div>
                            <p class="quote">"Had them pressure wash my driveway and house siding. The difference is night and
                                day! My neighbor already asked for their number."</p>
                            <div class="author">
                                <div class="avatar">MT</div>
                                <div class="info">
                                    <div class="name">Mike T.</div>
                                    <div class="meta">Richland, WA · Pressure Washing</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="swiper-slide">
                        <div class="testimonial-card">
                            <div class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i
                                    class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div>
                            <p class="quote">"Rented trash bins for our construction project in Kennewick. Delivery was prompt,
                                pickup on schedule, and pricing was fair. Will use again!"</p>
                            <div class="author">
                                <div class="avatar">JL</div>
                                <div class="info">
                                    <div class="name">James L.</div>
                                    <div class="meta">Kennewick, WA · Trash Bin Rental</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="swiper-pagination"></div>
            </div>
        </div>
    </section>

    <!-- Comparison -->
    <section class="section bg-light">
        <div class="container">
            <div class="section-header">
                <span class="section-label">Why Choose Us</span>
                <h2>3CLEANING vs. The Rest</h2>
                <p>See why homeowners across Tri-Cities trust us.</p>
            </div>
            <div class="compare-table">
                <div class="compare-header">
                    <div>Feature</div>
                    <div style="text-align:center;">3CLEANING</div>
                    <div style="text-align:center;">Others</div>
                </div>
                <div class="compare-row">
                    <div class="feature">Same-Day Service</div>
                    <div class="check"><i class="fas fa-check-circle"></i></div>
                    <div class="cross"><i class="fas fa-times-circle"></i></div>
                </div>
                <div class="compare-row">
                    <div class="feature">Upfront Pricing (No Hidden Fees)</div>
                    <div class="check"><i class="fas fa-check-circle"></i></div>
                    <div class="cross"><i class="fas fa-times-circle"></i></div>
                </div>
                <div class="compare-row">
                    <div class="feature">Licensed & Fully Insured</div>
                    <div class="check"><i class="fas fa-check-circle"></i></div>
                    <div class="maybe"><i class="fas fa-question-circle"></i></div>
                </div>
                <div class="compare-row">
                    <div class="feature">Eco-Friendly Disposal</div>
                    <div class="check"><i class="fas fa-check-circle"></i></div>
                    <div class="cross"><i class="fas fa-times-circle"></i></div>
                </div>
                <div class="compare-row">
                    <div class="feature">WhatsApp Support & Booking</div>
                    <div class="check"><i class="fas fa-check-circle"></i></div>
                    <div class="cross"><i class="fas fa-times-circle"></i></div>
                </div>
            </div>
        </div>
    </section>

    <!-- Areas -->
    <section class="section">
        <div class="container">
            <div class="section-header">
                <span class="section-label">Service Area</span>
                <h2>Where We Work</h2>
                <p>We come to you across the Tri-Cities region and beyond.</p>
            </div>
            <div class="areas-grid" style="max-width: 900px; margin: 0 auto;">
                <div class="area-card">
                    <i class="fas fa-map-marker-alt"></i>
                    <h4>Pasco</h4>
                    <p>Full coverage</p>
                </div>
                <div class="area-card">
                    <i class="fas fa-map-marker-alt"></i>
                    <h4>Richland</h4>
                    <p>All services</p>
                </div>
                <div class="area-card">
                    <i class="fas fa-map-marker-alt"></i>
                    <h4>Kennewick</h4>
                    <p>Fast response</p>
                </div>
                <div class="area-card">
                    <i class="fas fa-map-marker-alt"></i>
                    <h4>Walla Walla</h4>
                    <p>Extended area</p>
                </div>
                <div class="area-card">
                    <i class="fas fa-map-marker-alt"></i>
                    <h4>Benton City</h4>
                    <p>Reliable service</p>
                </div>
                <div class="area-card">
                    <i class="fas fa-map-marker-alt"></i>
                    <h4>Finley</h4>
                    <p>Community focused</p>
                </div>
                <div class="area-card">
                    <i class="fas fa-map-marker-alt"></i>
                    <h4>Burbank</h4>
                    <p>Complete coverage</p>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ -->
    <section class="section bg-light">
        <div class="container">
            <div class="section-header">
                <span class="section-label">FAQ</span>
                <h2>Common Questions</h2>
                <p>Quick answers. Visit our full FAQ for more details.</p>
            </div>
            <div class="faq-list">
                <div class="faq-item active">
                    <button class="faq-question">How much does junk removal cost in Tri-Cities? <i
                            class="fas fa-chevron-down"></i></button>
                    <div class="faq-answer">
                        <div class="faq-answer-content">Our junk removal starts at <strong>$325</strong> for a full
                            truck load. Pricing depends on volume and item types. We provide free on-site estimates in
                            all service areas.</div>
                    </div>
                </div>
                <div class="faq-item">
                    <button class="faq-question">Do you offer same-day service? <i
                            class="fas fa-chevron-down"></i></button>
                    <div class="faq-answer">
                        <div class="faq-answer-content">Yes! We offer same-day and next-day service depending on
                            availability. Call <a href="tel:+15095280560">(509) 528-0560</a> or message us on <a
                                href="https://wa.me/15095280560">WhatsApp</a> to check current slots.</div>
                    </div>
                </div>
                <div class="faq-item">
                    <button class="faq-question">What areas do you serve? <i class="fas fa-chevron-down"></i></button>
                    <div class="faq-answer">
                        <div class="faq-answer-content">We serve <strong>Pasco, Richland, Kennewick, Walla Walla, Benton
                                City, Finley, and Burbank, WA</strong>. Contact us if you're nearby — we may still be
                            able to help!</div>
                    </div>
                </div>
            </div>
            <div class="text-center" style="margin-top: 2rem;">
                <a href="/faq" class="btn btn-outline">View All FAQs <i class="fas fa-arrow-right"
                        style="margin-left:0.5rem;"></i></a>
            </div>
        </div>
    </section>

    <!-- Newsletter -->
    <section class="newsletter-section">
        <div class="container">
            <div style="max-width: 600px; margin: 0 auto; text-align: center;">
                <h2 style="color: white; margin-bottom: 0.75rem;">Cleaning Tips & Offers</h2>
                <p style="color: rgba(255,255,255,0.8); margin-bottom: 1.5rem;">Join 500+ Tri-Cities homeowners.
                    Seasonal guides, maintenance tips, and exclusive discounts.</p>
                <form style="display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: center;"
                    onsubmit="event.preventDefault(); this.innerHTML='<p style=\\'color:#38bdf8\\'>Thanks for subscribing!</p>';">
                    <input type="email" placeholder="Your email address" required
                        style="padding: 0.875rem 1.25rem; border: none; border-radius: 8px; font-size: 0.95rem; min-width: 280px; flex: 1; max-width: 360px;">
                    <button type="submit" class="btn"
                        style="background: var(--accent-light); color: var(--primary-dark); font-weight: 700;"><i
                            class="fas fa-paper-plane"></i> Subscribe</button>
                </form>
                <p style="color: rgba(255,255,255,0.5); font-size: 0.8rem; margin-top: 1rem;"><i
                        class="fas fa-lock"></i> No spam. Unsubscribe anytime.</p>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="section" style="background: var(--bg-warm);">
        <div class="container">
            <div style="max-width: 700px; margin: 0 auto; text-align: center;">
                <h2 style="margin-bottom: 0.75rem;">Ready for a Cleaner Space?</h2>
                <p style="color: var(--text-light); margin-bottom: 2rem;">Get your free quote today. No obligation, no
                    hassle.</p>
                <div
                    style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; margin-bottom: 1.5rem;">
                    <a href="/contact" class="btn btn-primary btn-lg"><i class="fas fa-calendar-check"></i> Free
                        Quote</a>
                    <a href="tel:+15095280560" class="btn btn-outline btn-lg"><i class="fas fa-phone"></i> Call Now</a>
                </div>
                <div
                    style="display: flex; gap: 1.5rem; justify-content: center; flex-wrap: wrap; color: var(--text-muted); font-size: 0.85rem;">
                    <span><i class="fas fa-check" style="color: var(--success);"></i> Free Estimates</span>
                    <span><i class="fas fa-check" style="color: var(--success);"></i> No Hidden Fees</span>
                    <span><i class="fas fa-check" style="color: var(--success);"></i> Satisfaction Guaranteed</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
</Layout>

---
import Layout from '../layouts/Layout.astro';
import { site } from '../config/site';
---

<Layout title={`${site.nameFull} | Pricing`}>
<section class="breadcrumb">
        <div class="container">
            <h1>Our Pricing</h1>
            <div class="breadcrumb-nav"><a href="/">Home</a><i class="fas fa-chevron-right"
                    style="font-size:0.7rem;"></i><span>Pricing</span></div>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <div class="section-header">
                <span class="section-label">Transparent Rates</span>
                <h2>No Hidden Fees, Ever</h2>
                <p>Upfront pricing for every service. Know exactly what you'll pay before we start.</p>
            </div>
            <div class="pricing-table">
                <div class="pricing-header">
                    <h3><i class="fas fa-clipboard-list"></i> Service Pricing</h3>
                    <p>Prices are estimates. Final quotes depend on job scope.</p>
                </div>
                <div class="pricing-row">
                    <div>
                        <div class="service-name">Junk Removal</div>
                        <div class="service-desc">Full truck load — furniture, appliances, debris</div>
                    </div>
                    <div class="price">$150</div>
                </div>
                <div class="pricing-row">
                    <div>
                        <div class="service-name">Pressure Washing</div>
                        <div class="service-desc">House exterior, driveway, deck (starting)</div>
                    </div>
                    <div class="price">$175</div>
                </div>
                <div class="pricing-row">
                    <div>
                        <div class="service-name">Trash Bin Service</div>
                        <div class="service-desc">Per bin rental and pickup</div>
                    </div>
                    <div class="price">$20<span style="font-size:0.9rem;color:var(--text-muted);">/bin</span></div>
                </div>
                <div class="pricing-row">
                    <div>
                        <div class="service-name">House Cleaning</div>
                        <div class="service-desc">Deep cleaning, move-in/move-out (custom)</div>
                    </div>
                    <div class="price">Custom</div>
                </div>
                <div class="pricing-row">
                    <div>
                        <div class="service-name">Yard Cleanup</div>
                        <div class="service-desc">Brush removal, leaf cleanup, yard waste</div>
                    </div>
                    <div class="price">Custom</div>
                </div>
                <div class="pricing-note">
                    <i class="fas fa-info-circle" style="color: var(--accent);"></i> Prices may vary based on job size,
                    location, and requirements. Contact us for a free detailed quote.
                </div>
            </div>
            <div class="text-center" style="margin-top: 2rem;">
                <a href="/contact" class="btn btn-primary btn-lg"><i class="fas fa-calculator"></i> Get Free
                    Quote</a>
            </div>
        </div>
    </section>

    <section class="section bg-light">
        <div class="container">
            <div class="section-header">
                <span class="section-label">What's Included</span>
                <h2>Every Service Includes</h2>
            </div>
            <div class="features-grid">
                <div class="feature-item">
                    <div class="feature-icon"><i class="fas fa-check"></i></div>
                    <div class="feature-content">
                        <h3>Free On-Site Estimate</h3>
                        <p>We assess your needs and provide an accurate quote before any work begins.</p>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon"><i class="fas fa-check"></i></div>
                    <div class="feature-content">
                        <h3>Labor & Equipment</h3>
                        <p>All necessary tools, equipment, and labor included in our pricing.</p>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon"><i class="fas fa-check"></i></div>
                    <div class="feature-content">
                        <h3>Responsible Disposal</h3>
                        <p>We handle disposal and recycling according to local regulations.</p>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon"><i class="fas fa-check"></i></div>
                    <div class="feature-content">
                        <h3>Satisfaction Guarantee</h3>
                        <p>If you're not satisfied, we'll make it right at no extra cost.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>

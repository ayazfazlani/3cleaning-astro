---
import Layout from '../layouts/Layout.astro';
---

<Layout title="3CLEANING SERVICE | Gallery" description="Professional cleaning services.">
<section class="breadcrumb">
        <div class="container">
            <h1>Our Work</h1>
            <div class="breadcrumb-nav">
                <a href="/">Home</a>
                <i class="fas fa-chevron-right" style="font-size: 0.7rem;"></i>
                <span>Gallery</span>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <div class="section-header">
                <h2>Project Gallery</h2>
                <p>See the transformation our team delivers. From cluttered spaces to spotless properties.</p>
            </div>

            <div class="gallery-grid">
                <div class="gallery-item">
                    <img src="assets/images/one.jpeg" alt="Junk removal before and after - Tri-Cities WA"
                        loading="lazy">
                    <div class="gallery-overlay">
                        <h4>Junk Removal - Residential</h4>
                    </div>
                </div>
                <div class="gallery-item">
                    <img src="assets/images/two.jpeg" alt="Pressure washing driveway - Pasco WA" loading="lazy">
                    <div class="gallery-overlay">
                        <h4>Pressure Washing - Driveway</h4>
                    </div>
                </div>
                <div class="gallery-item">
                    <img src="assets/images/three.jpeg" alt="Commercial junk removal - Richland WA" loading="lazy">
                    <div class="gallery-overlay">
                        <h4>Junk Removal - Commercial</h4>
                    </div>
                </div>
                <div class="gallery-item">
                    <img src="assets/images/four.jpeg" alt="House pressure washing - Kennewick WA" loading="lazy">
                    <div class="gallery-overlay">
                        <h4>House Exterior Cleaning</h4>
                    </div>
                </div>
                <div class="gallery-item">
                    <img src="assets/images/five.jpeg" alt="Trash bin service - Walla Walla WA" loading="lazy">
                    <div class="gallery-overlay">
                        <h4>Trash Bin Service</h4>
                    </div>
                </div>
                <div class="gallery-item">
                    <img src="assets/images/two.jpeg" alt="Yard cleanup and brush removal" loading="lazy">
                    <div class="gallery-overlay">
                        <h4>Yard Cleanup</h4>
                    </div>
                </div>
                <div class="gallery-item">
                    <img src="assets/images/six.jpeg" alt="Deck pressure washing - Benton City WA" loading="lazy">
                    <div class="gallery-overlay">
                        <h4>Deck Restoration</h4>
                    </div>
                </div>
                <div class="gallery-item">
                    <img src="assets/images/one.jpeg" alt="Garage cleanout service" loading="lazy">
                    <div class="gallery-overlay">
                        <h4>Garage Cleanout</h4>
                    </div>
                </div>
            </div>

            <div class="text-center mt-3">
                <p style="margin-bottom: 1.5rem; color: var(--gray);">Have a project in mind? Let us add your
                    transformation to our gallery!</p>
                <a href="/contact" class="btn btn-primary"><i class="fas fa-camera"></i> Share Your Project</a>
            </div>
        </div>
    </section>

    <!-- Footer -->
</Layout>

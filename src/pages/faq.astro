---
import Layout from '../layouts/Layout.astro';
import { site } from '../config/site';
---

<Layout title={`${site.nameFull} | FAQ`}>
<section class="breadcrumb">
        <div class="container">
            <h1>FAQ</h1>
            <div class="breadcrumb-nav"><a href="/">Home</a><i class="fas fa-chevron-right"
                    style="font-size:0.7rem;"></i><span>FAQ</span></div>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <div class="section-header">
                <span class="section-label">Help Center</span>
                <h2>Frequently Asked Questions</h2>
                <p>Everything you need to know about our cleaning and junk removal services.</p>
            </div>
            <div class="faq-list">
                <div class="faq-item active">
                    <button class="faq-question">How much does junk removal cost in Tri-Cities? <i
                            class="fas fa-chevron-down"></i></button>
                    <div class="faq-answer">
                        <div class="faq-answer-content">Our junk removal service starts at <strong>$325</strong> for a
                            full truck load. The final price depends on the volume and type of items being removed. We
                            provide free on-site estimates so you know exactly what to expect before we start.</div>
                    </div>
                </div>
                <div class="faq-item">
                    <button class="faq-question">What areas do you serve? <i class="fas fa-chevron-down"></i></button>
                    <div class="faq-answer">
                        <div class="faq-answer-content">We serve <strong>Pasco, Richland, Kennewick, Walla Walla, Benton
                                City, Finley, and Burbank, Washington</strong>. If you're nearby but not listed, contact
                            us — we may still be able to help!</div>
                    </div>
                </div>
                <div class="faq-item">
                    <button class="faq-question">Do you offer same-day service? <i
                            class="fas fa-chevron-down"></i></button>
                    <div class="faq-answer">
                        <div class="faq-answer-content">Yes! Depending on availability, we offer same-day and next-day
                            service for urgent cleaning and junk removal needs. Call us at <a
                                href={`tel:${site.phoneTel}`}>{site.phone}</a> or message us on <a
                                href={site.whatsappUrl}>WhatsApp</a> to check availability.</div>
                    </div>
                </div>
                <div class="faq-item">
                    <button class="faq-question">What items do you remove? <i class="fas fa-chevron-down"></i></button>
                    <div class="faq-answer">
                        <div class="faq-answer-content">We remove furniture, appliances, electronics, yard waste,
                            construction debris, garage items, and general household junk. We do <strong>not</strong>
                            handle hazardous materials, chemicals, or biohazard waste.</div>
                    </div>
                </div>
                <div class="faq-item">
                    <button class="faq-question">Is your company licensed and insured? <i
                            class="fas fa-chevron-down"></i></button>
                    <div class="faq-answer">
                        <div class="faq-answer-content">Absolutely. {site.nameFull} is fully licensed and insured for
                            your protection and peace of mind. We take professionalism seriously.</div>
                    </div>
                </div>
                <div class="faq-item">
                    <button class="faq-question">How does pressure washing pricing work? <i
                            class="fas fa-chevron-down"></i></button>
                    <div class="faq-answer">
                        <div class="faq-answer-content">Pressure washing starts at <strong>$175</strong> and varies
                            based on the surface area, type of surface, and level of cleaning needed. Driveways, house
                            exteriors, decks, and patios each have different requirements. Contact us for a custom
                            quote.</div>
                    </div>
                </div>
                <div class="faq-item">
                    <button class="faq-question">Do I need to be present during the service? <i
                            class="fas fa-chevron-down"></i></button>
                    <div class="faq-answer">
                        <div class="faq-answer-content">Not necessarily. Many of our clients provide access instructions
                            and we complete the job while they're away. However, we recommend being present for the
                            initial walkthrough and final inspection to ensure everything meets your expectations.</div>
                    </div>
                </div>
                <div class="faq-item">
                    <button class="faq-question">What payment methods do you accept? <i
                            class="fas fa-chevron-down"></i></button>
                    <div class="faq-answer">
                        <div class="faq-answer-content">We accept cash, credit/debit cards, Venmo, and Zelle. Payment is
                            typically due upon completion of service.</div>
                    </div>
                </div>
                <div class="faq-item">
                    <button class="faq-question">How do I schedule a service? <i
                            class="fas fa-chevron-down"></i></button>
                    <div class="faq-answer">
                        <div class="faq-answer-content">You can schedule by calling <a href={`tel:${site.phoneTel}`}>{site.phone}</a>, messaging us on <a href={site.whatsappUrl}>WhatsApp</a>, or
                            filling out the form on our <a href="/contact">Contact page</a>. We'll get back to you
                            within 24 hours.</div>
                    </div>
                </div>
            </div>
            <div class="text-center" style="margin-top: 2rem;">
                <p style="color: var(--text-light); margin-bottom: 1rem;">Still have questions?</p>
                <a href="/contact" class="btn btn-primary"><i class="fas fa-envelope"></i> Contact Us</a>
            </div>
        </div>
    </section>
</Layout>

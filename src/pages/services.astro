---
import Layout from '../layouts/Layout.astro';
---

<Layout title="3CLEANING SERVICE | Services" description="Professional cleaning services.">
<section class="breadcrumb">
        <div class="container">
            <h1>Our Services</h1>
            <div class="breadcrumb-nav"><a href="index.html">Home</a><i class="fas fa-chevron-right"
                    style="font-size:0.7rem;"></i><span>Services</span></div>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <div class="section-header">
                <span class="section-label">What We Offer</span>
                <h2>Comprehensive Cleaning Solutions</h2>
                <p>From heavy-duty junk removal to precision pressure washing, we handle it all with professionalism.
                </p>
            </div>

            <div style="display: grid; grid-template-columns: 1fr; gap: 2rem; max-width: 900px; margin: 0 auto;">
                <div class="card" style="display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: center;">
                    <div>
                        <div class="card-icon"><i class="fas fa-truck-loading"></i></div>
                        <h3 style="margin-bottom: 0.5rem;">Junk Removal</h3>
                        <p style="margin-bottom: 1rem;">Full-service junk removal for homes, offices, and construction
                            sites. We haul away furniture, appliances, yard waste, construction debris, and more. No job
                            too big or small.</p>
                        <ul class="features" style="margin-bottom: 1.5rem;">
                            <li><i class="fas fa-check"></i> Furniture & Appliance Removal</li>
                            <li><i class="fas fa-check"></i> Construction Debris Cleanup</li>
                            <li><i class="fas fa-check"></i> Yard Waste & Brush Removal</li>
                            <li><i class="fas fa-check"></i> Garage & Basement Cleanouts</li>
                            <li><i class="fas fa-check"></i> Estate Cleanouts</li>
                        </ul>
                        <div class="price" style="font-size: 1.75rem; font-weight: 800; color: var(--primary);">$325
                            <span style="font-size:0.95rem;color:var(--text-muted);font-weight:500;">per full
                                load</span>
                        </div>
                        <a href="contact.html?service=junk" class="btn btn-primary" style="margin-top:1rem;"><i
                                class="fas fa-calendar-check"></i> Book This Service</a>
                    </div>
                </div>

                <div class="card" style="display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: center;">
                    <div>
                        <div class="card-icon"><i class="fas fa-spray-can"></i></div>
                        <h3 style="margin-bottom: 0.5rem;">Pressure Washing</h3>
                        <p style="margin-bottom: 1rem;">Restore your property's appearance with commercial-grade
                            pressure washing. We remove dirt, grime, mold, and stains from any surface safely and
                            effectively.</p>
                        <ul class="features" style="margin-bottom: 1.5rem;">
                            <li><i class="fas fa-check"></i> Driveway & Sidewalk Cleaning</li>
                            <li><i class="fas fa-check"></i> House Siding & Exterior Walls</li>
                            <li><i class="fas fa-check"></i> Deck & Patio Restoration</li>
                            <li><i class="fas fa-check"></i> Fence Cleaning</li>
                            <li><i class="fas fa-check"></i> Roof & Gutter Cleaning</li>
                        </ul>
                        <div class="price" style="font-size: 1.75rem; font-weight: 800; color: var(--primary);">$175
                            <span style="font-size:0.95rem;color:var(--text-muted);font-weight:500;">starting
                                price</span>
                        </div>
                        <a href="contact.html?service=pressure" class="btn btn-primary" style="margin-top:1rem;"><i
                                class="fas fa-calendar-check"></i> Book This Service</a>
                    </div>
                </div>

                <div class="card" style="display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: center;">
                    <div>
                        <div class="card-icon"><i class="fas fa-trash-alt"></i></div>
                        <h3 style="margin-bottom: 0.5rem;">Trash Bin Service</h3>
                        <p style="margin-bottom: 1rem;">Convenient trash bin rental and pickup for events, renovations,
                            and ongoing waste management. Clean bins delivered, scheduled pickup, hassle-free.</p>
                        <ul class="features" style="margin-bottom: 1.5rem;">
                            <li><i class="fas fa-check"></i> Event Waste Management</li>
                            <li><i class="fas fa-check"></i> Construction Site Bins</li>
                            <li><i class="fas fa-check"></i> Residential Cleanup Bins</li>
                            <li><i class="fas fa-check"></i> Scheduled Pickup Service</li>
                            <li><i class="fas fa-check"></i> Same-Day Delivery Available</li>
                        </ul>
                        <div class="price" style="font-size: 1.75rem; font-weight: 800; color: var(--primary);">$20
                            <span style="font-size:0.95rem;color:var(--text-muted);font-weight:500;">per bin</span>
                        </div>
                        <a href="contact.html?service=bin" class="btn btn-primary" style="margin-top:1rem;"><i
                                class="fas fa-calendar-check"></i> Book This Service</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section bg-light">
        <div class="container">
            <div class="section-header">
                <span class="section-label">Process</span>
                <h2>How It Works</h2>
                <p>Three simple steps from quote to completion.</p>
            </div>
            <div class="process-grid">
                <div class="process-step">
                    <div class="number">1</div>
                    <h3>Request Quote</h3>
                    <p>Call, WhatsApp, or fill our form. Free estimate in minutes.</p>
                </div>
                <div class="process-step">
                    <div class="number">2</div>
                    <h3>Schedule Service</h3>
                    <p>Pick a date. We offer flexible scheduling including weekends.</p>
                </div>
                <div class="process-step">
                    <div class="number">3</div>
                    <h3>Job Complete</h3>
                    <p>We arrive on time, work efficiently, and leave no trace.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="container" style="max-width: 700px; text-align: center;">
            <h2 style="margin-bottom: 1rem;">Need a Custom Service?</h2>
            <p style="color: var(--text-light); margin-bottom: 1.5rem;">Have a unique project? We handle special
                requests and custom cleaning jobs. Tell us what you need.</p>
            <a href="contact.html" class="btn btn-primary btn-lg"><i class="fas fa-envelope"></i> Contact Us</a>
        </div>
    </section>
</Layout>

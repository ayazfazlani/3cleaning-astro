---
import Layout from '../layouts/Layout.astro';
---

<Layout title="3CLEANING SERVICE | About" description="Professional cleaning services.">
<section class="breadcrumb">
        <div class="container">
            <h1>About Us</h1>
            <div class="breadcrumb-nav"><a href="index.html">Home</a><i class="fas fa-chevron-right"
                    style="font-size:0.7rem;"></i><span>About</span></div>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <div
                style="display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: center; max-width: 1000px; margin: 0 auto;">
                <div>
                    <span class="section-label">Our Story</span>
                    <h2 style="margin-bottom: 1rem;">Your Trusted Cleaning Partner in Tri-Cities</h2>
                    <p style="margin-bottom: 1rem;">3CLEANING SERVICE was founded with a simple mission: provide
                        reliable, professional cleaning services that make life easier for homeowners and businesses
                        across Washington's Tri-Cities region.</p>
                    <p style="margin-bottom: 1rem;">What started as a small operation has grown into one of the most
                        trusted names in cleaning services, serving Pasco, Richland, Kennewick, Walla Walla, and
                        surrounding communities.</p>
                    <p style="margin-bottom: 2rem;">We understand every property is unique, which is why we tailor our
                        services to your specific needs. Whether a one-time junk removal or regular pressure washing
                        maintenance, we deliver consistent, exceptional results.</p>

                    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem;">
                        <div
                            style="text-align: center; padding: 1.5rem; background: var(--bg); border-radius: var(--radius);">
                            <div style="font-size: 2rem; font-weight: 800; color: var(--accent);">500+</div>
                            <div style="font-size: 0.9rem; color: var(--text-light);">Projects Completed</div>
                        </div>
                        <div
                            style="text-align: center; padding: 1.5rem; background: var(--bg); border-radius: var(--radius);">
                            <div style="font-size: 2rem; font-weight: 800; color: var(--accent);">7</div>
                            <div style="font-size: 0.9rem; color: var(--text-light);">Cities Covered</div>
                        </div>
                        <div
                            style="text-align: center; padding: 1.5rem; background: var(--bg); border-radius: var(--radius);">
                            <div style="font-size: 2rem; font-weight: 800; color: var(--accent);">100%</div>
                            <div style="font-size: 0.9rem; color: var(--text-light);">Satisfaction Rate</div>
                        </div>
                        <div
                            style="text-align: center; padding: 1.5rem; background: var(--bg); border-radius: var(--radius);">
                            <div style="font-size: 2rem; font-weight: 800; color: var(--accent);">24/7</div>
                            <div style="font-size: 0.9rem; color: var(--text-light);">Support Available</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section bg-light">
        <div class="container">
            <div class="section-header">
                <span class="section-label">Our Values</span>
                <h2>What We Stand For</h2>
            </div>
            <div class="features-grid">
                <div class="feature-item">
                    <div class="feature-icon"><i class="fas fa-heart"></i></div>
                    <div class="feature-content">
                        <h3>Integrity First</h3>
                        <p>Honest pricing, clear communication, doing what's right every time.</p>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon"><i class="fas fa-broom"></i></div>
                    <div class="feature-content">
                        <h3>Attention to Detail</h3>
                        <p>No corner untouched. We treat every property as if it were our own.</p>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon"><i class="fas fa-users"></i></div>
                    <div class="feature-content">
                        <h3>Customer Focused</h3>
                        <p>Your satisfaction is our priority. We listen and adapt to exceed expectations.</p>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon"><i class="fas fa-leaf"></i></div>
                    <div class="feature-content">
                        <h3>Eco-Conscious</h3>
                        <p>Environmentally responsible disposal and eco-friendly solutions whenever possible.</p>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon"><i class="fas fa-handshake"></i></div>
                    <div class="feature-content">
                        <h3>Reliability</h3>
                        <p>When we say we'll be there, we mean it. Punctuality is our foundation.</p>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon"><i class="fas fa-chart-line"></i></div>
                    <div class="feature-content">
                        <h3>Continuous Improvement</h3>
                        <p>We constantly refine methods and invest in better equipment.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>

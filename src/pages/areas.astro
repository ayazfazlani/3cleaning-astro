---
import Layout from '../layouts/Layout.astro';
---

<Layout title="3CLEANING SERVICE | Areas" description="Professional cleaning services.">
<section class="breadcrumb">
        <div class="container">
            <h1>Service Areas</h1>
            <div class="breadcrumb-nav"><a href="index.html">Home</a><i class="fas fa-chevron-right"
                    style="font-size:0.7rem;"></i><span>Areas</span></div>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <div class="section-header">
                <span class="section-label">Coverage</span>
                <h2>Where We Work</h2>
                <p>We proudly serve communities across the Tri-Cities region and southeastern Washington.</p>
            </div>
            <div class="areas-grid"
                style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); max-width: 900px; margin: 0 auto;">
                <div class="area-card" style="padding: 2rem;">
                    <i class="fas fa-map-marker-alt" style="font-size: 2rem; margin-bottom: 1rem;"></i>
                    <h4 style="font-size: 1.1rem; margin-bottom: 0.5rem;">Pasco, WA</h4>
                    <p style="font-size: 0.85rem;">Full residential & commercial coverage</p>
                </div>
                <div class="area-card" style="padding: 2rem;">
                    <i class="fas fa-map-marker-alt" style="font-size: 2rem; margin-bottom: 1rem;"></i>
                    <h4 style="font-size: 1.1rem; margin-bottom: 0.5rem;">Richland, WA</h4>
                    <p style="font-size: 0.85rem;">Comprehensive cleaning services</p>
                </div>
                <div class="area-card" style="padding: 2rem;">
                    <i class="fas fa-map-marker-alt" style="font-size: 2rem; margin-bottom: 1rem;"></i>
                    <h4 style="font-size: 1.1rem; margin-bottom: 0.5rem;">Kennewick, WA</h4>
                    <p style="font-size: 0.85rem;">Fast response times guaranteed</p>
                </div>
                <div class="area-card" style="padding: 2rem;">
                    <i class="fas fa-map-marker-alt" style="font-size: 2rem; margin-bottom: 1rem;"></i>
                    <h4 style="font-size: 1.1rem; margin-bottom: 0.5rem;">Walla Walla, WA</h4>
                    <p style="font-size: 0.85rem;">Extended to Walla Walla valley</p>
                </div>
                <div class="area-card" style="padding: 2rem;">
                    <i class="fas fa-map-marker-alt" style="font-size: 2rem; margin-bottom: 1rem;"></i>
                    <h4 style="font-size: 1.1rem; margin-bottom: 0.5rem;">Benton City, WA</h4>
                    <p style="font-size: 0.85rem;">Reliable cleaning solutions</p>
                </div>
                <div class="area-card" style="padding: 2rem;">
                    <i class="fas fa-map-marker-alt" style="font-size: 2rem; margin-bottom: 1rem;"></i>
                    <h4 style="font-size: 1.1rem; margin-bottom: 0.5rem;">Finley, WA</h4>
                    <p style="font-size: 0.85rem;">Dedicated community service</p>
                </div>
                <div class="area-card" style="padding: 2rem;">
                    <i class="fas fa-map-marker-alt" style="font-size: 2rem; margin-bottom: 1rem;"></i>
                    <h4 style="font-size: 1.1rem; margin-bottom: 0.5rem;">Burbank, WA</h4>
                    <p style="font-size: 0.85rem;">Complete area coverage</p>
                </div>
            </div>
            <div class="text-center" style="margin-top: 2rem;">
                <p style="color: var(--text-light); margin-bottom: 1rem;">Not sure if we serve your area? Contact us and
                    we'll confirm.</p>
                <a href="contact.html" class="btn btn-primary"><i class="fas fa-phone"></i> Contact Us</a>
            </div>
        </div>
    </section>
</Layout>

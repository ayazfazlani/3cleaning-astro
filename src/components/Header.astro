---
const currentPath = new URL(Astro.request.url).pathname;
---
<!-- Announcement -->
<div class="announcement">
    <i class="fas fa-bolt"></i> Same-Day Service Available — Call <a href="tel:+15095280560">(509) 528-0560</a> or
    <a href="https://wa.me/15095280560">WhatsApp</a>
</div>

<!-- Header -->
<header class="header">
    <div class="container">
        <nav class="nav">
            <a href="/" class="logo">
                <img src="/assets/logo.jpeg" alt="3CLEANING SERVICE">
                <span class="logo-text">3CLEANING<span>SERVICE</span></span>
            </a>
            <div class="nav-links">
                <a href="/" class={currentPath === '/' ? 'active' : ''}>Home</a>
                <a href="/services" class={currentPath.startsWith('/services') ? 'active' : ''}>Services</a>
                <a href="/about" class={currentPath.startsWith('/about') ? 'active' : ''}>About</a>
                <a href="/areas" class={currentPath.startsWith('/areas') ? 'active' : ''}>Areas</a>
                <a href="/pricing" class={currentPath.startsWith('/pricing') ? 'active' : ''}>Pricing</a>
                <a href="/contact" class={currentPath.startsWith('/contact') ? 'active' : ''}>Contact</a>
            </div>
            <div class="nav-cta">
                <a href="tel:+15095280560" class="btn btn-dark btn-sm"><i class="fas fa-phone"></i></a>
                <a href="https://wa.me/15095280560" target="_blank" class="btn btn-whatsapp btn-sm"><i class="fab fa-whatsapp"></i></a>
                <a href="/contact" class="btn btn-primary">Get Quote</a>
            </div>
            <button class="mobile-menu-btn" aria-label="Menu"><span></span><span></span><span></span></button>
        </nav>
    </div>
    <div class="mobile-nav">
        <a href="/">Home</a>
        <a href="/services">Services</a>
        <a href="/about">About</a>
        <a href="/areas">Service Areas</a>
        <a href="/pricing">Pricing</a>
        <a href="/gallery">Gallery</a>
        <a href="/faq">FAQ</a>
        <a href="/contact">Contact</a>
        <a href="tel:+15095280560" class="btn btn-primary"><i class="fas fa-phone"></i> Call Now</a>
    </div>
</header>

---
import { site } from '../config/site';
---
<footer class="footer">
    <div class="container">
        <div class="footer-grid">
            <div class="footer-brand">
                <img src="/assets/logo.jpeg" alt={site.nameFull} style="max-height: 48px; border-radius: 6px;">
                <p>{site.description}</p>
                <div class="footer-social">
                    <a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a>
                    <a href={`tel:${site.phoneTel}`} aria-label="Phone"><i class="fas fa-phone"></i></a>
                    <a href={`mailto:${site.email}`} aria-label="Email"><i class="fas fa-envelope"></i></a>
                </div>
            </div>
            <div class="footer-links">
                <h4>Company</h4>
                <a href="/">Home</a>
                <a href="/services">Services</a>
                <a href="/about">About</a>
                <a href="/pricing">Pricing</a>
                <a href="/contact">Contact</a>
            </div>
            <div class="footer-links">
                <h4>Services</h4>
                <a href="/contact?service=junk">Junk Removal</a>
                <a href="/contact?service=pressure">Pressure Washing</a>
                <a href="/contact?service=bin">Trash Bin Service</a>
                <a href="/contact">House Cleaning</a>
            </div>
            <div class="footer-contact">
                <h4>Contact</h4>
                <p><i class="fas fa-phone"></i> <a href={`tel:${site.phoneTel}`}>{site.phone}</a></p>
                <p><i class="fab fa-whatsapp"></i> <a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp</a></p>
                <p><i class="fas fa-envelope"></i> <a href={`mailto:${site.email}`}>{site.email}</a></p>
                <p><i class="fas fa-clock"></i> Mon–Sat: 8AM – 6PM</p>
            </div>
        </div>
        <div class="footer-bottom">
            <p>© <span class="current-year"></span> {site.nameFull}. All rights reserved.</p>
            <p><a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></p>
        </div>
    </div>
</footer>
